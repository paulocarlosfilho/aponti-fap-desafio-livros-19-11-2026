PORT=3001
NODE_ENV=development

# Opção 1: Conexão via URL completa (Padrão Render / Produção)
# DATABASE_URL=postgresql://usuario:senha@host:5432/books_db

# Opção 2: Conexão via variáveis individuais (Desenvolvimento Local / Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=books_db
DB_SSL=false

# Origens permitidas no CORS (ex: https://lendomais-frontend.onrender.com ou * para testes)
CORS_ORIGIN=*
